#!/bin/bash
# Neovim backend for MOS.
# The Neovim release tree is installed by the plugin .deb at /usr/lib/neovim.
# Config and data live on a mounted pool; state and cache live in RAM.

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 022

. "${NEOVIM_ENV:-/usr/share/neovim-plugin/neovim-env}"

SETTINGS="$NEOVIM_SETTINGS"
SHARE_DIR="$NEOVIM_SHARE_DIR"

say() { echo "$*"; }

write_default_settings() {
  cat > "$SETTINGS" <<'JSON'
{
  "config_dir": "",
  "data_dir": ""
}
JSON
}

ensure_settings() {
  mkdir -p "$NEOVIM_PLUGIN_DIR"
  if command -v jq >/dev/null 2>&1 && [ -f "$SETTINGS" ] && ! jq empty "$SETTINGS" >/dev/null 2>&1; then
    cp -f "$SETTINGS" "$SETTINGS.bak.$(date +%s)" 2>/dev/null || true
    rm -f "$SETTINGS"
  fi
  if [ ! -f "$SETTINGS" ]; then
    if [ -f "$SHARE_DIR/settings.json" ]; then
      cp -f "$SHARE_DIR/settings.json" "$SETTINGS"
    else
      write_default_settings
    fi
  fi
}

current_version() {
  if [ -x "$NEOVIM_USR_LIB_DIR/bin/nvim" ]; then
    "$NEOVIM_USR_LIB_DIR/bin/nvim" --version 2>/dev/null | head -n1 | awk '{print $2}' | sed 's/^v//'
  fi
}

cmd_prepare() {
  neovim_prepare
  return 0
}

cmd_status() {
  local installed=false version config_exists=false

  neovim_resolve_paths
  neovim_migrate_config
  neovim_ensure_paths

  if [ -f "$NEOVIM_CONFIG_ROOT/nvim/init.lua" ] || [ -f "$NEOVIM_CONFIG_ROOT/nvim/init.vim" ]; then
    config_exists=true
  fi

  if [ -x "$NEOVIM_USR_LIB_DIR/bin/nvim" ]; then
    installed=true
  fi

  version="$(current_version)"
  [ -n "$version" ] || version="not installed"

  printf '{"installed":%s,"version":"%s","config":"%s","config_root":"%s","data":"%s","data_root":"%s","data_mode":"%s","config_mode":"%s","storage_mode":"%s","pool_root":"%s","config_exists":%s,"runtime":"%s","plugin_dir":"%s","release":"%s","state_root":"%s","cache_root":"%s","command":"nvim"}\n' \
    "$installed" "$version" "$NEOVIM_CONFIG_ROOT/nvim/init.lua" "$NEOVIM_CONFIG_ROOT" \
    "$NEOVIM_DATA_ROOT" "$NEOVIM_DATA_ROOT" "$NEOVIM_DATA_MODE" "$NEOVIM_CONFIG_MODE" \
    "$NEOVIM_STORAGE_MODE" "$NEOVIM_POOL_ROOT" "$config_exists" \
    "$NEOVIM_USR_LIB_DIR/share/nvim/runtime" "$NEOVIM_PLUGIN_DIR" "$NEOVIM_USR_LIB_DIR" \
    "$NEOVIM_STATE_ROOT" "$NEOVIM_CACHE_ROOT"
}

cmd_init_config() {
  neovim_prepare
  local dir="$NEOVIM_CONFIG_ROOT/nvim" file
  file="$dir/init.lua"
  mkdir -p "$dir"
  if [ -f "$file" ]; then
    say "Config already exists: $file"
    return 0
  fi
  cat > "$file" <<'LUA'
-- Neovim configuration for MOS
-- This file lives on the MOS pool and survives reboots.
vim.opt.number = true
vim.opt.relativenumber = true
vim.opt.termguicolors = true
vim.opt.expandtab = true
vim.opt.shiftwidth = 2
vim.opt.tabstop = 2
LUA
  say "Created $file"
}

cmd_uninstall() {
  rm -f /usr/bin/plugins/neovim 2>/dev/null || true
  say "Removed Neovim plugin entry. Config and data kept on the pool."
}

ensure_settings

case "${1:-}" in
  status) cmd_status ;;
  init_config) cmd_init_config ;;
  prepare) cmd_prepare ;;
  version) current_version ;;
  uninstall) cmd_uninstall ;;
  *)
    echo "Usage: $0 {status|init_config|prepare|version|uninstall}" >&2
    exit 2
    ;;
esac