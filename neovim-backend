#!/bin/bash
# Neovim backend for MOS.
# The Neovim release tree is installed by the plugin .deb at /usr/lib/neovim.
# This backend only reports status and creates a starter init.lua.

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 022

PLG_DIR="${NEOVIM_PLUGIN_DIR:-/boot/optional/plugins/neovim}"
SETTINGS="$PLG_DIR/settings.json"
USR_LIB_DIR="${NEOVIM_USR_LIB_DIR:-/usr/lib/neovim}"
RAM_DIR="${NEOVIM_RAM_DIR:-/run/neovim}"
SHARE_DIR="${NEOVIM_SHARE_DIR:-/usr/share/neovim-plugin}"

export XDG_CONFIG_HOME="$PLG_DIR/config"
export XDG_STATE_HOME="$RAM_DIR/state"
export XDG_DATA_HOME="$RAM_DIR/data"
export XDG_CACHE_HOME="$RAM_DIR/cache"

mkdir -p "$PLG_DIR" "$XDG_CONFIG_HOME" "$XDG_STATE_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" 2>/dev/null

say() { echo "$*"; }

write_default_settings() {
  cat > "$SETTINGS" <<'JSON'
{
  "data_dir": ""
}
JSON
}

ensure_settings() {
  mkdir -p "$PLG_DIR"
  if [ -f "$SETTINGS" ] && ! jq empty "$SETTINGS" >/dev/null 2>&1; then
    cp -f "$SETTINGS" "$SETTINGS.bak.$(date +%s)" 2>/dev/null || true
    rm -f "$SETTINGS"
  fi
  if [ ! -f "$SETTINGS" ]; then
    if [ -f "$SHARE_DIR/settings.json" ]; then
      cp -f "$SHARE_DIR/settings.json" "$SETTINGS"
    else
      write_default_settings
    fi
  fi
}

setting() {
  jq -r --arg k "$1" '.[$k] // empty' "$SETTINGS" 2>/dev/null
}

current_version() {
  if [ -x "$USR_LIB_DIR/bin/nvim" ]; then
    "$USR_LIB_DIR/bin/nvim" --version 2>/dev/null | head -n1 | awk '{print $2}' | sed 's/^v//'
  fi
}

cmd_status() {
  local installed=false version config data data_mode config_exists=false
  config="$XDG_CONFIG_HOME/nvim/init.lua"
  if [ -f "$config" ] || [ -f "$XDG_CONFIG_HOME/nvim/init.vim" ]; then
    config_exists=true
  fi

  data="$(setting data_dir)"
  if [ -n "$data" ]; then
    data_mode="persistent"
  else
    data="$RAM_DIR/data"
    data_mode="memory"
  fi

  if [ -x "$USR_LIB_DIR/bin/nvim" ]; then
    installed=true
  fi

  version="$(current_version)"
  [ -n "$version" ] || version="not installed"

  printf '{"installed":%s,"version":"%s","config":"%s","data":"%s","data_mode":"%s","config_exists":%s,"runtime":"%s","plugin_dir":"%s","release":"%s","config_root":"%s","state_root":"%s","command":"nvim"}\n' \
    "$installed" "$version" "$config" "$data" "$data_mode" "$config_exists" "$USR_LIB_DIR/share/nvim/runtime" "$PLG_DIR" "$USR_LIB_DIR" "$XDG_CONFIG_HOME" "$XDG_STATE_HOME"
}

cmd_init_config() {
  local dir="$XDG_CONFIG_HOME/nvim" file
  file="$dir/init.lua"
  mkdir -p "$dir"
  if [ -f "$file" ]; then
    say "Config already exists: $file"
    return 0
  fi
  cat > "$file" <<'LUA'
-- Neovim configuration for MOS
-- This file lives under /boot/optional/plugins/neovim/config/nvim
vim.opt.number = true
vim.opt.relativenumber = true
vim.opt.termguicolors = true
vim.opt.expandtab = true
vim.opt.shiftwidth = 2
vim.opt.tabstop = 2
LUA
  say "Created $file"
}

cmd_uninstall() {
  rm -f /usr/bin/plugins/neovim 2>/dev/null || true
  say "Removed Neovim plugin entry. Config kept in $PLG_DIR"
}

ensure_settings

case "${1:-}" in
  status) cmd_status ;;
  init_config) cmd_init_config ;;
  version) current_version ;;
  uninstall) cmd_uninstall ;;
  *)
    echo "Usage: $0 {status|init_config|version|uninstall}" >&2
    exit 2
    ;;
esac