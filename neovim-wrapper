#!/bin/sh
# Neovim wrapper for MOS.
# Keeps config, data, state and cache under the persistent plugin directory.
# /usr/lib/neovim is a RAM copy of the official release tree, so /boot can be noexec.

PLG_DIR="${NEOVIM_PLUGIN_DIR:-/boot/optional/plugins/neovim}"
LIB_DIR="${NEOVIM_USR_LIB_DIR:-/usr/lib/neovim}"

if [ -x "$LIB_DIR/bin/nvim" ]; then
  NVIM="$LIB_DIR/bin/nvim"
  VIMRUNTIME="$LIB_DIR/share/nvim/runtime"
else
  NVIM="$PLG_DIR/nvim/bin/nvim"
  VIMRUNTIME="$PLG_DIR/nvim/share/nvim/runtime"
fi

if [ ! -x "$NVIM" ]; then
  echo "Neovim is not installed yet. Open the Neovim plugin in MOS and click Install." >&2
  exit 127
fi

export XDG_CONFIG_HOME="$PLG_DIR/config"
export XDG_STATE_HOME="$PLG_DIR/state"
export VIMRUNTIME

RAM_DIR="${NEOVIM_RAM_DIR:-/run/neovim}"
DATA_DIR="$RAM_DIR/data"
CACHE_DIR="$RAM_DIR/cache"
if command -v jq >/dev/null 2>&1 && [ -f "$PLG_DIR/settings.json" ]; then
  custom="$(jq -r '.data_dir // empty' "$PLG_DIR/settings.json" 2>/dev/null)"
  if [ -n "$custom" ]; then
    case "$custom" in
      /*) ;;
      *) echo "data_dir must be an absolute path" >&2; exit 1 ;;
    esac
    case "$custom" in
      "$PLG_DIR/data"|"$PLG_DIR/data/"*) ;;
      "$PLG_DIR"|"$PLG_DIR/"*)
        echo "data_dir must be outside $PLG_DIR (except $PLG_DIR/data); use a pool path such as /mnt/cache/appdata/neovim" >&2
        exit 1
        ;;
    esac
    DATA_DIR="$custom"
    CACHE_DIR="$custom/cache"
  fi
fi

export XDG_DATA_HOME="$DATA_DIR"
export XDG_CACHE_HOME="$CACHE_DIR"

mkdir -p "$XDG_CONFIG_HOME/nvim" "$XDG_STATE_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" 2>/dev/null || true

exec "$NVIM" "$@"