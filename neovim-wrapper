#!/bin/sh
# Neovim wrapper for MOS.
# The release tree is installed by the plugin .deb at /usr/lib/neovim.
# Config and data live on a mounted pool; state and cache live in RAM.

. "${NEOVIM_ENV:-/usr/share/neovim-plugin/neovim-env}"

if [ ! -x "$NEOVIM_USR_LIB_DIR/bin/nvim" ]; then
  echo "Neovim is not installed. Reinstall the Neovim plugin from MOS Hub." >&2
  exit 127
fi

neovim_prepare

export XDG_CONFIG_HOME="$NEOVIM_CONFIG_ROOT"
export XDG_DATA_HOME="$NEOVIM_DATA_ROOT"
export XDG_STATE_HOME="$NEOVIM_STATE_ROOT"
export XDG_CACHE_HOME="$NEOVIM_CACHE_ROOT"
export VIMRUNTIME="$NEOVIM_USR_LIB_DIR/share/nvim/runtime"

exec "$NEOVIM_USR_LIB_DIR/bin/nvim" "$@"